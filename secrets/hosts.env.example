# Шаблон доступа к хостам парка (без секретов).
#
# Скопировать в secrets/hosts.env и заполнить:
#   cp secrets/hosts.env.example secrets/hosts.env
#   chmod 600 secrets/hosts.env
#
# secrets/hosts.env не коммитится (см. .gitignore). Значения — без кавычек,
# без пробелов вокруг '='; файл подключается через `set -a; . secrets/hosts.env`.

# Стенд v24-350 (BTT CB2, Manta M8P V2.0)
V24_350_HOST=<ip-or-hostname>
V24_350_SSH_USER=<ssh-user>
V24_350_SSH_PASS=<ssh-password>